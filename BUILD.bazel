load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library", "cuda_test")

package(default_visibility = ["//visibility:private"])

APGAR_COPTS = [
    "-Wall",
    "-Werror",
    "-Wextra",
    "-Wpedantic",
]

cc_library(
    name = "utf8",
    hdrs = ["include/apgar/text/utf8.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "board_ir",
    srcs = ["src/board_ir/board.cc"],
    hdrs = [
        "include/apgar/board_ir/board.h",
        "include/apgar/board_ir/stable_hash.h",
    ],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [":utf8"],
)

cc_library(
    name = "exact_geometry",
    srcs = ["src/geometry/exact.cc"],
    hdrs = ["include/apgar/geometry/exact.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [":board_ir"],
)

cc_library(
    name = "geometry_compiler",
    srcs = ["src/geometry_compiler/compiled_board.cc"],
    hdrs = ["include/apgar/geometry_compiler/compiled_board.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":exact_geometry",
    ],
)

cc_library(
    name = "cpu_astar",
    srcs = ["src/routing/cpu_astar.cc"],
    hdrs = ["include/apgar/routing/cpu_astar.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":exact_geometry",
        ":geometry_compiler",
    ],
)

cc_library(
    name = "gpu_planar_router",
    srcs = [
        "src/gpu/device_board.cc",
        "src/gpu/planar_router.cc",
    ],
    hdrs = ["include/apgar/gpu/planar_router.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":cpu_astar",
        ":geometry_compiler",
    ],
)

cuda_library(
    name = "cuda_planar_route_backend",
    srcs = ["gpu/cuda/planar_router.cu"],
    copts = ["-std=c++20"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":cuda_planar_route_backend_api"],
)

cc_library(
    name = "cuda_planar_route_backend_api",
    hdrs = ["include/apgar/gpu/cuda_backend.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [":gpu_planar_router"],
)

cc_library(
    name = "planar_benchmark_corpus",
    srcs = ["src/benchmark/planar_corpus.cc"],
    hdrs = ["include/apgar/benchmark/planar_corpus.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":cpu_astar",
        ":geometry_compiler",
        ":kicad_fixture_adapter",
    ],
)

cc_library(
    name = "kicad_fixture_adapter",
    srcs = ["src/adapters/kicad_fixture.cc"],
    hdrs = ["include/apgar/adapters/kicad_fixture.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":utf8",
    ],
)

cc_library(
    name = "apgar",
    srcs = ["src/version.cc"],
    hdrs = ["include/apgar/version.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":cpu_astar",
        ":exact_geometry",
        ":geometry_compiler",
        ":gpu_planar_router",
        ":kicad_fixture_adapter",
    ],
)

cc_binary(
    name = "apgar_smoke",
    srcs = ["tools/apgar_smoke.cc"],
    copts = APGAR_COPTS,
    deps = [":apgar"],
)

cc_binary(
    name = "gpu_replay",
    srcs = ["tools/gpu_replay.cc"],
    copts = APGAR_COPTS,
    data = [
        "replays/gpu/goal_predecessor_self_cycle_v1.replay",
        "tests/fixtures/m1_exactness.kicad_pcb",
    ],
    tags = [
        "manual",
        "requires-gpu",
    ],
    deps = [
        ":board_ir",
        ":cuda_planar_route_backend",
        ":geometry_compiler",
        ":gpu_planar_router",
        ":kicad_fixture_adapter",
    ],
)

cc_binary(
    name = "planar_benchmark",
    srcs = ["tools/planar_benchmark.cc"],
    copts = APGAR_COPTS,
    data = ["tests/fixtures/m1_exactness.kicad_pcb"],
    tags = [
        "manual",
        "requires-gpu",
    ],
    deps = [
        ":board_ir",
        ":cpu_astar",
        ":cuda_planar_route_backend",
        ":gpu_planar_router",
        ":planar_benchmark_corpus",
        "@google_benchmark//:benchmark",
    ],
)

