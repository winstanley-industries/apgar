load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

APGAR_COPTS = [
    "-Wall",
    "-Werror",
    "-Wextra",
    # toolchains_llvm selects libc++ on Linux; Clang 22 reports that toolchain
    # flag as unused during compilation. Keep it visible without weakening
    # errors for source-level warnings.
    "-Wno-error=unused-command-line-argument",
    "-Wpedantic",
]

cc_library(
    name = "utf8",
    hdrs = ["include/apgar/text/utf8.h"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "board_ir",
    srcs = ["src/board_ir/board.cc"],
    hdrs = [
        "include/apgar/board_ir/board.h",
        "include/apgar/board_ir/stable_hash.h",
    ],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [":utf8"],
)

cc_library(
    name = "exact_geometry",
    srcs = ["src/geometry/exact.cc"],
    hdrs = ["include/apgar/geometry/exact.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [":board_ir"],
)

cc_library(
    name = "geometry_compiler",
    srcs = ["src/geometry_compiler/compiled_board.cc"],
    hdrs = ["include/apgar/geometry_compiler/compiled_board.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":exact_geometry",
    ],
)

cc_library(
    name = "cpu_astar",
    srcs = ["src/routing/cpu_astar.cc"],
    hdrs = ["include/apgar/routing/cpu_astar.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":exact_geometry",
        ":geometry_compiler",
    ],
)

cc_library(
    name = "kicad_fixture_adapter",
    srcs = ["src/adapters/kicad_fixture.cc"],
    hdrs = ["include/apgar/adapters/kicad_fixture.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":utf8",
    ],
)

cc_library(
    name = "apgar",
    srcs = ["src/version.cc"],
    hdrs = ["include/apgar/version.h"],
    copts = APGAR_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":board_ir",
        ":cpu_astar",
        ":exact_geometry",
        ":geometry_compiler",
        ":kicad_fixture_adapter",
    ],
)

cc_binary(
    name = "apgar_smoke",
    srcs = ["tools/apgar_smoke.cc"],
    copts = APGAR_COPTS,
    deps = [":apgar"],
)

cc_test(
    name = "board_ir_test",
    size = "small",
    srcs = [
        "tests/board_ir/board_test.cc",
        "tests/support/board_builder.h",
        "tests/support/google_test.h",
    ],
    copts = APGAR_COPTS,
    deps = [
        ":board_ir",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "exact_geometry_test",
    size = "small",
    srcs = [
        "tests/geometry/exact_test.cc",
        "tests/support/board_builder.h",
        "tests/support/google_test.h",
    ],
    copts = APGAR_COPTS,
    deps = [
        ":board_ir",
        ":exact_geometry",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "geometry_compiler_test",
    size = "small",
    srcs = [
        "tests/geometry_compiler/compiled_board_test.cc",
        "tests/support/board_builder.h",
        "tests/support/compiler_builder.h",
        "tests/support/google_test.h",
    ],
    copts = APGAR_COPTS,
    deps = [
        ":board_ir",
        ":exact_geometry",
        ":geometry_compiler",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "cpu_astar_test",
    size = "small",
    srcs = [
        "tests/routing/cpu_astar_test.cc",
        "tests/support/board_builder.h",
        "tests/support/compiler_builder.h",
        "tests/support/google_test.h",
    ],
    copts = APGAR_COPTS,
    data = ["tests/fixtures/m1_exactness.kicad_pcb"],
    deps = [
        ":board_ir",
        ":cpu_astar",
        ":geometry_compiler",
        ":kicad_fixture_adapter",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "kicad_fixture_adapter_test",
    size = "small",
    srcs = [
        "tests/adapters/kicad_fixture_test.cc",
        "tests/support/google_test.h",
    ],
    copts = APGAR_COPTS,
    data = ["tests/fixtures/m1_exactness.kicad_pcb"],
    deps = [
        ":board_ir",
        ":exact_geometry",
        ":kicad_fixture_adapter",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "version_test",
    size = "small",
    srcs = [
        "tests/support/google_test.h",
        "tests/version_test.cc",
    ],
    copts = APGAR_COPTS,
    deps = [
        ":apgar",
        "@googletest//:gtest_main",
    ],
)
