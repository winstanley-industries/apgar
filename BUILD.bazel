# The CUDA host/device boundary cannot currently be instrumented end-to-end by
# the pinned LLVM sanitizer runtimes. Reject the combination at analysis time
# instead of silently presenting a partially instrumented CUDA build as a
# sanitizer result.
CUDA_SANITIZER_COMPATIBILITY = select({
    ":asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
}) + select({
    ":ubsan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Sanitizer registration roots otherwise-dead sections in the shared-source
# configuration-preimage graph, which violates the H4096 generator's
# capability-minimal link contract. Reject an instrumented generator rather
# than presenting a partially sanitized artifact. Sanitizer gates still run
# the independently instrumented structural test and link-inspect the ordinary
# generator through an explicit transition below.
H4096_GENERATOR_SANITIZER_COMPATIBILITY = select({
    ":asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
}) + select({
    ":ubsan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

