    ],
    tags = [
        "manual",
        "requires-gpu",
    ],
    deps = [
        ":board_ir",
        ":cuda_planar_route_backend",
        ":geometry_compiler",
        ":gpu_planar_router",
        ":kicad_fixture_adapter",
    ],
)

cuda_test(
    name = "cuda_smoke_test",
    size = "small",
    srcs = ["gpu/cuda/smoke_test.cu"],
    tags = [
        "manual",
        "requires-gpu",
    ],
)

