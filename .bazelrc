common --announce_rc
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1

build --cxxopt=-std=c++20
build --spawn_strategy=sandboxed

test --test_output=errors
test --spawn_strategy=sandboxed

build:debug --compilation_mode=dbg
build:release --compilation_mode=opt

# Published measurements use optimized APGAR and Google Benchmark binaries.
build:benchmark --compilation_mode=opt

build:asan --@llvm//config:asan=True

build:ubsan --@llvm//config:ubsan=True

# Phase 2 reference CUDA platform: checksum-pinned CUDA Toolkit 13.0.2, nvcc,
# hermetic GCC 15.2.0, and native/PTX code for compute capability 12.0. CUDA
# targets are manual and remain outside default CPU-only //... builds.
build:cuda --@rules_cuda//cuda:enable=True
build:cuda --@rules_cuda//cuda:compiler=nvcc
build:cuda --@rules_cuda//cuda:archs=compute_120:compute_120,sm_120
build:cuda --extra_toolchains=@apgar_cuda_gcc15//:cc_toolchain
test:cuda --test_output=all

try-import %workspace%/.bazelrc.user
